{% extends 'admin/layout.html.twig' %}

{% block admin_title %}{{ 'admin.nav.roles'|trans }}{% endblock %}
{% block admin_heading %}{{ 'admin.nav.roles'|trans }}{% endblock %}
{% block admin_breadcrumbs %}
    <a href="{{ path('admin_dashboard') }}">{{ 'admin.nav.dashboard'|trans }}</a>
    <span aria-hidden="true">/</span>
    <span aria-current="page">{{ 'admin.nav.roles'|trans }}</span>
{% endblock %}

{% block admin_body %}
    {% import 'admin/_icons.html.twig' as icons %}
    {% set has_row_actions = can_update or can_deactivate %}
    <section class="module-panel module-panel--table">
        <div class="module-panel__header">
            <div>
                <p class="app-kicker">{{ 'roles.access_control'|trans }}</p>
                <h2>{{ 'roles.system_roles'|trans }}</h2>
            </div>
            {% if can_create %}
                <button
                    class="btn btn-primary admin-create-button"
                    type="button"
                    data-bs-toggle="modal"
                    data-bs-target="#createRoleModal"
                    aria-label="{{ 'roles.create_role'|trans }}"
                    title="{{ 'roles.create_role'|trans }}"
                >
                    {{ icons.create() }}
                    <span>{{ 'roles.create'|trans }}</span>
                </button>
            {% endif %}
        </div>

        {% if action_error %}
            <div class="admin-inline-alert alert alert-danger js-auto-dismiss-alert" role="alert">{{ action_error|trans }}</div>
        {% endif %}

        <div class="table-responsive">
            <table class="table table-bordered admin-table js-data-table mb-0">
                <thead>
                    <tr>
                        <th>{{ 'role.name'|trans }}</th>
                        <th>{{ 'role.admin_access'|trans }}</th>
                        <th class="admin-table__cell--left dt-left dt-head-left">{{ 'role.users_count'|trans }}</th>
                        <th>{{ 'role.status'|trans }}</th>
                        {% if has_row_actions %}
                            <th class="no-sort">{{ 'common.actions'|trans }}</th>
                        {% endif %}
                    </tr>
                </thead>
                <tbody>
                    {% for role in roles %}
                        {% set can_toggle_status = role.active ? can_deactivate : can_update %}
                        <tr>
                            <td>{{ role.label(app.request.locale) }}</td>
                            <td>{{ (role.is_admin ? 'common.yes' : 'common.no')|trans }}</td>
                            <td class="admin-table__cell--left dt-left dt-body-left">{{ role.users_count }}</td>
                            <td>{{ (role.active ? 'role.active' : 'role.inactive')|trans }}</td>
                            {% if has_row_actions %}
                                <td>
                                    <div class="admin-row-actions">
                                        {% if can_update %}
                                            <button
                                                class="btn admin-row-action admin-row-action--edit"
                                                type="button"
                                                data-bs-toggle="modal"
                                                data-bs-target="#editRoleModal{{ role.id }}"
                                                aria-label="{{ 'common.update'|trans }}"
                                                title="{{ 'common.update'|trans }}"
                                            >
                                                {{ icons.edit() }}
                                            </button>
                                        {% endif %}

                                        {% if can_toggle_status %}
                                            <form
                                                method="post"
                                                action="{{ path('admin_roles_toggle_status', { id: role.id }) }}"
                                                onsubmit="return confirm('{{ (role.active ? 'roles.confirm_disable' : 'roles.confirm_activate')|trans|e('html_attr') }}')"
                                            >
                                                <button
                                                    class="btn admin-row-action {{ role.active ? 'admin-row-action--active' : 'admin-row-action--inactive' }}"
                                                    type="submit"
                                                    aria-label="{{ (role.active ? 'common.disable' : 'common.activate')|trans }}"
                                                    title="{{ (role.active ? 'common.disable' : 'common.activate')|trans }}"
                                                    {{ current_user and current_user.role_id == role.id ? 'disabled' : '' }}
                                                >
                                                    {% if role.active %}
                                                        {{ icons.activate() }}
                                                    {% else %}
                                                        {{ icons.disable() }}
                                                    {% endif %}
                                                </button>
                                            </form>
                                        {% endif %}
                                    </div>
                                </td>
                            {% endif %}
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </section>

    {% if can_update %}
        {% for role in roles %}
        {% set is_edit_modal_open = open_edit_role_id == role.id %}
        {% set form_name = is_edit_modal_open ? edit_form.name : role.label(app.request.locale) %}
        {% set form_is_admin = is_edit_modal_open ? edit_form.is_admin : role.is_admin %}
        {% set form_active = is_edit_modal_open ? edit_form.active : role.active %}
        <div
            class="modal fade admin-compact-modal"
            id="editRoleModal{{ role.id }}"
            tabindex="-1"
            aria-labelledby="editRoleModalLabel{{ role.id }}"
            aria-hidden="true"
            data-open-modal="{{ is_edit_modal_open ? 'true' : 'false' }}"
        >
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <form method="post" action="{{ path('admin_roles_update', { id: role.id }) }}" class="admin-form">
                        <div class="modal-header">
                            <div>
                                <p class="app-kicker">{{ 'roles.access_control'|trans }}</p>
                                <h2 class="modal-title" id="editRoleModalLabel{{ role.id }}">{{ 'roles.update_role'|trans }}</h2>
                            </div>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="{{ 'common.close'|trans }}"></button>
                        </div>

                        <div class="modal-body">
                            {% if is_edit_modal_open and edit_error %}
                                <div class="alert alert-danger js-auto-dismiss-alert" role="alert">{{ edit_error|trans }}</div>
                            {% endif %}

                            {% include 'admin/roles/_form_fields.html.twig' with {
                                form_name: form_name,
                                form_is_admin: form_is_admin,
                                form_active: form_active,
                                include_active: true
                            } only %}
                        </div>

                        <div class="modal-footer">
                            <button class="btn btn-outline-secondary" type="button" data-bs-dismiss="modal">{{ 'common.cancel'|trans }}</button>
                            <button class="btn btn-primary" type="submit">{{ 'common.save'|trans }}</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
        {% endfor %}
    {% endif %}

    {% if can_create %}
        <div
            class="modal fade admin-compact-modal"
            id="createRoleModal"
            tabindex="-1"
            aria-labelledby="createRoleModalLabel"
            aria-hidden="true"
            data-open-modal="{{ open_create_modal ? 'true' : 'false' }}"
        >
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <form method="post" action="{{ path('admin_roles_create') }}" class="admin-form">
                        <div class="modal-header">
                            <div>
                                <p class="app-kicker">{{ 'roles.access_control'|trans }}</p>
                                <h2 class="modal-title" id="createRoleModalLabel">{{ 'roles.new_system_role'|trans }}</h2>
                            </div>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="{{ 'common.close'|trans }}"></button>
                        </div>

                        <div class="modal-body">
                            {% if create_error %}
                                <div class="alert alert-danger js-auto-dismiss-alert" role="alert">{{ create_error|trans }}</div>
                            {% endif %}

                            {% include 'admin/roles/_form_fields.html.twig' with {
                                form_name: create_form.name,
                                form_is_admin: create_form.is_admin,
                                form_active: true,
                                include_active: false
                            } only %}
                        </div>

                        <div class="modal-footer">
                            <button class="btn btn-outline-secondary" type="button" data-bs-dismiss="modal">{{ 'common.cancel'|trans }}</button>
                            <button class="btn btn-primary" type="submit">{{ 'roles.create_role'|trans }}</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    {% endif %}
{% endblock %}
