{% extends 'admin/layout.html.twig' %}

{% block admin_title %}{{ 'admin.nav.competencies'|trans }}{% endblock %}
{% block admin_heading %}{{ 'admin.nav.competencies'|trans }}{% endblock %}
{% block admin_breadcrumbs %}<a href="{{ path('admin_dashboard') }}">{{ 'admin.nav.dashboard'|trans }}</a><span aria-hidden="true">/</span><span>{{ 'admin.nav.competencies'|trans }}</span>{% endblock %}

{% macro fields(form, sections) %}
    <label>{{ 'competency.name'|trans }}<input class="form-control" name="name" value="{{ form.name|default('') }}" required maxlength="190"></label>
    <label>{{ 'competency.type'|trans }}<select class="form-select" name="competency_type" required><option value="skill" {{ form.competency_type|default('skill') == 'skill' ? 'selected' : '' }}>{{ 'competency.skill'|trans }}</option><option value="knowledge" {{ form.competency_type|default('') == 'knowledge' ? 'selected' : '' }}>{{ 'competency.knowledge'|trans }}</option></select></label>
    <div class="competency-score-row"><label>{{ 'competency.minimum_score'|trans }}<input class="form-control" type="number" name="minimum_score" min="0" max="100" step="1" value="{{ form.minimum_score|default(0) }}" required></label></div>
    <div class="competency-pair-picker" data-competency-pair-picker data-remove-label="{{ 'common.delete'|trans }}" data-critical-label="{{ 'competency.critical'|trans }}">
        <span class="admin-field__label">{{ 'competency.functions'|trans }}</span>
        <div class="competency-pair-picker__fields">
            <div class="competency-pair-picker__search">
                <input class="form-control" type="search" data-competency-section-search placeholder="{{ 'competency.search_department'|trans }}" autocomplete="off">
                <div class="admin-smart-search__suggestions" data-competency-section-suggestions hidden>
                    {% for section in sections %}<button type="button" class="admin-smart-search__suggestion" data-section-id="{{ section.id }}">{{ section.factoryDepartmentLabel() }} / {{ section.label() }}</button>{% endfor %}
                </div>
            </div>
            <div class="competency-pair-picker__search">
                <input class="form-control" type="search" data-competency-function-search placeholder="{{ 'competency.search_function'|trans }}" autocomplete="off" disabled>
                <div class="admin-smart-search__suggestions" data-competency-function-suggestions hidden>
                    {% for section in sections %}{% for function in section.positions %}<button type="button" class="admin-smart-search__suggestion" data-section-id="{{ section.id }}" data-pair="{{ section.id }}:{{ function.id }}">{{ function.label() }}</button>{% endfor %}{% endfor %}
                </div>
            </div>
            <button class="btn admin-row-action admin-row-action--edit" type="button" data-competency-add-function aria-label="{{ 'competency.add_function'|trans }}" title="{{ 'competency.add_function'|trans }}"><svg viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M8 3v10M3 8h10" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg></button>
        </div>
        <div class="competency-pair-picker__list" data-competency-function-list>
            {% for selected_pair in form.function_pairs|default([]) %}
                {% for section in sections %}{% for function in section.positions %}{% set pair = section.id ~ ':' ~ function.id %}{% if pair == selected_pair %}<div class="competency-pair-picker__item" data-pair="{{ pair }}"><span>{{ section.factoryDepartmentLabel() }} / {{ section.label() }} / {{ function.label() }}</span><label class="competency-pair-picker__critical"><input type="checkbox" name="function_pair_critical[{{ pair }}]" value="1" {{ form.function_pair_critical[pair]|default(false) ? 'checked' : '' }}><span>{{ 'competency.critical'|trans }}</span></label><button type="button" data-competency-remove-function aria-label="{{ 'common.delete'|trans }}">&times;</button><input type="hidden" name="function_pairs[]" value="{{ pair }}"></div>{% endif %}{% endfor %}{% endfor %}
            {% endfor %}
        </div>
    </div>
{% endmacro %}

{% block admin_body %}
    {% import 'admin/_icons.html.twig' as icons %}
    {% import _self as forms %}
    {% set has_row_actions = can_update or can_deactivate or can_delete %}
    <section class="module-panel module-panel--table">
        <div class="module-panel__header"><div><p class="app-kicker">{{ 'competencies.kicker'|trans }}</p><h2>{{ 'competencies.title'|trans }}</h2></div><div class="admin-competency-header-actions"><a class="btn admin-secondary-button" href="{{ path('admin_competencies_matrix') }}" title="{{ 'competencies.matrix_title'|trans }}"><svg class="admin-secondary-button__icon" viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M2.5 3.5h11M2.5 8h11M2.5 12.5h11M6 2.4v11.2M10 2.4v11.2"/></svg><span>{{ 'competencies.matrix'|trans }}</span></a>{% if can_create %}<button class="btn btn-primary admin-create-button" type="button" data-bs-toggle="modal" data-bs-target="#createCompetencyModal" title="{{ 'competencies.create_record'|trans }}">{{ icons.create() }}<span>{{ 'common.create'|trans }}</span></button>{% endif %}</div></div>
        {% if create_error or edit_error %}<div class="admin-inline-alert alert alert-danger js-auto-dismiss-alert" role="alert">{{ (create_error ?: edit_error)|trans }}</div>{% endif %}
        <div class="competency-column-filters" data-competency-column-filters>
            <label>{{ 'catalog.factory_department'|trans }}<input class="form-control" type="search" data-competency-column-filter="1" placeholder="{{ 'catalog.factory_department'|trans }}" autocomplete="off"></label>
            <label>{{ 'competency.department'|trans }}<input class="form-control" type="search" data-competency-column-filter="2" placeholder="{{ 'competency.department'|trans }}" autocomplete="off"></label>
        </div>
        <div class="table-responsive"><table class="table table-bordered admin-table js-data-table mb-0" data-hidden-columns="1,2"><thead><tr><th>{{ 'competency.name'|trans }}</th><th>{{ 'catalog.factory_department'|trans }}</th><th>{{ 'competency.department'|trans }}</th><th>{{ 'competency.functions'|trans }}</th><th>{{ 'competency.type'|trans }}</th><th>{{ 'competency.minimum_score'|trans }}</th><th>{{ 'catalog.status'|trans }}</th>{% if has_row_actions %}<th class="no-sort">{{ 'common.actions'|trans }}</th>{% endif %}</tr></thead><tbody>
            {% for competency in competencies %}<tr><td>{{ competency.label() }}</td><td><div class="admin-catalog-tags admin-catalog-tags--compact">{% for label in competency.functionPairDepartmentLabels() %}<span class="admin-catalog-tag">{{ label }}</span>{% else %}-{% endfor %}</div></td><td><div class="admin-catalog-tags admin-catalog-tags--compact">{% for label in competency.functionPairSectionLabels() %}<span class="admin-catalog-tag">{{ label }}</span>{% else %}-{% endfor %}</div></td><td><div class="competency-function-cell"><button type="button" class="competency-function-cell__toggle" data-competency-functions-toggle aria-expanded="false"><span>{{ competency.functionPairDisplayData()|length }}</span><span class="visually-hidden">{{ 'competency.functions'|trans }}</span><svg viewBox="0 0 16 16" aria-hidden="true"><path d="m4 6 4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg></button><div class="admin-catalog-tags admin-catalog-tags--compact" data-competency-functions-list hidden>{% for pair in competency.functionPairDisplayData() %}<span class="admin-catalog-tag {{ pair.critical ? 'admin-catalog-tag--critical' : 'admin-catalog-tag--noncritical' }}" title="{{ pair.critical ? 'competency.critical'|trans : '' }}">{{ pair.label }}</span>{% else %}-{% endfor %}</div></div></td><td>{{ (competency.competency_type == 'skill' ? 'competency.skill' : 'competency.knowledge')|trans }}</td><td>{{ competency.minimum_score }}%</td><td>{{ (competency.active ? 'catalog.active' : 'catalog.inactive')|trans }}</td>{% if has_row_actions %}<td><div class="admin-row-actions">{% if can_update %}<button class="btn admin-row-action admin-row-action--edit" type="button" data-bs-toggle="modal" data-bs-target="#editCompetencyModal{{ competency.id }}" title="{{ 'common.update'|trans }}" aria-label="{{ 'common.update'|trans }}">{{ icons.edit() }}</button>{% endif %}{% if competency.active and can_deactivate %}<form method="post" action="{{ path('admin_competencies_toggle_status', {id: competency.id}) }}" onsubmit="return confirm('{{ 'competencies.confirm_deactivate'|trans|e('html_attr') }}')"><button class="btn admin-row-action admin-row-action--active" type="submit" title="{{ 'common.disable'|trans }}" aria-label="{{ 'common.disable'|trans }}">{{ icons.activate() }}</button></form>{% elseif not competency.active and can_update %}<form method="post" action="{{ path('admin_competencies_toggle_status', {id: competency.id}) }}"><button class="btn admin-row-action admin-row-action--inactive" type="submit" title="{{ 'common.activate'|trans }}" aria-label="{{ 'common.activate'|trans }}">{{ icons.disable() }}</button></form>{% endif %}{% if can_delete %}<form method="post" action="{{ path('admin_competencies_delete', {id: competency.id}) }}" onsubmit="return confirm('{{ 'competencies.confirm_physical_delete'|trans|e('html_attr') }}')"><button class="btn admin-row-action admin-row-action--delete" type="submit" title="{{ 'common.delete'|trans }}" aria-label="{{ 'common.delete'|trans }}">{{ icons.trash() }}</button></form>{% endif %}</div></td>{% endif %}</tr>{% endfor %}
        </tbody></table></div>
    </section>
    {% if can_update %}{% for competency in competencies %}{% set is_open = open_edit_competency_id == competency.id %}{% set form = is_open ? edit_form : {name: competency.name, function_pairs: competency.functionPairKeys(), function_pair_critical: competency.functionPairCriticals(), competency_type: competency.competency_type, minimum_score: competency.minimum_score} %}<div class="modal fade admin-compact-modal" id="editCompetencyModal{{ competency.id }}" tabindex="-1" data-open-modal="{{ is_open ? 'true' : 'false' }}"><div class="modal-dialog modal-dialog-centered"><div class="modal-content"><form method="post" action="{{ path('admin_competencies_update', {id: competency.id}) }}" class="admin-form"><div class="modal-header"><h2 class="modal-title">{{ 'competencies.update_record'|trans }}</h2><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div><div class="modal-body">{% if is_open and edit_error %}<div class="alert alert-danger js-auto-dismiss-alert" role="alert">{{ edit_error|trans }}</div>{% endif %}{{ forms.fields(form, sections) }}</div><div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">{{ 'common.cancel'|trans }}</button><button type="submit" class="btn btn-primary">{{ 'common.save'|trans }}</button></div></form></div></div></div>{% endfor %}{% endif %}
    {% if can_create %}<div class="modal fade admin-compact-modal" id="createCompetencyModal" tabindex="-1" data-open-modal="{{ open_create_modal ? 'true' : 'false' }}"><div class="modal-dialog modal-dialog-centered"><div class="modal-content"><form method="post" action="{{ path('admin_competencies_create') }}" class="admin-form"><div class="modal-header"><h2 class="modal-title">{{ 'competencies.new_record'|trans }}</h2><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div><div class="modal-body">{% if create_error %}<div class="alert alert-danger js-auto-dismiss-alert" role="alert">{{ create_error|trans }}</div>{% endif %}{{ forms.fields(create_form, sections) }}</div><div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">{{ 'common.cancel'|trans }}</button><button type="submit" class="btn btn-primary">{{ 'common.save'|trans }}</button></div></form></div></div></div>{% endif %}
{% endblock %}
